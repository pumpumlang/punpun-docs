#!/bin/ksh
#
# privctl -- Mullvad WireGuard, Hysteria 2 and the fail-closed pf locks on the
# OpenBSD privacy VM. Installed to /usr/local/sbin/privctl by install.sh.
#
#   privctl status
#
#   privctl mullvad import FILE|DIR|TGZ   store your Mullvad WireGuard configs (0600)
#   privctl mullvad list [PREFIX]         e.g. list se  |  list us-nyc
#   privctl mullvad use [NAME|PREFIX]     write /etc/hostname.wg0, bring wg0 up, route all via it
#   privctl mullvad test                  prove traffic exits via Mullvad
#   privctl mullvad down                  remove wg0 (only when no lock is on)
#
#   privctl hy2 check-config|start|stop|restart|enable|disable|test
#
#   privctl lock mullvad    pf kill switch: only WireGuard may leave the NAT NIC;
#                           the services VM is routed (NAT) through Mullvad too
#   privctl lock tunnel     pf kill switch: only Hysteria may leave (inside
#                           Mullvad when wg0 is up); services VM uses the proxies
#   privctl confirm         keep the lock (otherwise it auto-reverts)
#   privctl persist         keep the current lock across reboots
#   privctl unlock          back to the normal pf ruleset (alias: recover)
#   privctl proxy-env       proxy variables for shells and apps
#
# A lock is refused until the matching `test` passed for the current config,
# and reverts by itself unless confirmed -- administration is never cut off by
# an untested policy.

set -u
PATH=/sbin:/bin:/usr/sbin:/usr/bin:/usr/local/sbin:/usr/local/bin
umask 077

SETTINGS=/etc/privkit.conf
HY_CONFIG=/etc/hysteria/config.yaml
MV_DIR=/etc/mullvad
MV_CONFS=$MV_DIR/configs
WG_IF=wg0
WG_FILE=/etc/hostname.$WG_IF
PF_OUT=/etc/privkit-pf.conf
STATE=/var/db/privkit
MARK="generated by privctl"
HOSTS_BEGIN="# privctl-pin-begin"
HOSTS_END="# privctl-pin-end"
SELF=/usr/local/sbin/privctl

LAN_MAC="08:00:27:77:00:01"; LAN_IF=""; LAN_ADDR="10.77.0.1"; LAN_NET="10.77.0.0/24"
SERVICES_IP="10.77.0.2"; NAT_IF=""; ADMIN_SSH_FROM="10.0.2.2"; ADMIN_SSH_PORT="22"
PIHOLE_DNS="10.77.0.2"; LAN_PROXY_PORTS="1080 8080 5353"; SERVER_PF_PORTS=""
CONFIRM_TIMEOUT="180"; MULLVAD_CHECK_URL="https://am.i.mullvad.net/connected"
HY2_TEST_URL="https://cdn.openbsd.org/pub/OpenBSD/7.9/SHA256"; TEST_DNS_NAME="openbsd.org"
# shellcheck source=etc/privkit.conf
[ -r "$SETTINGS" ] && . "$SETTINGS"

say()  { print -r -- "$*"; }
ok()   { print -r -- " ok   $*"; }
bad()  { print -r -- " FAIL $*" >&2; }
warn() { print -r -- " warn $*" >&2; }
die()  { print -r -- "privctl: $*" >&2; exit 1; }
need_root() { [ "$(id -u)" -eq 0 ] || die "run as root (doas privctl ...)"; }
logmsg() { logger -t privctl -- "$*"; }

mode() { cat "$STATE/mode" 2>/dev/null || echo open; }
set_mode() { mkdir -p "$STATE"; echo "$1" >"$STATE/mode"; }
fsum() { sha256 -q "$1" 2>/dev/null; }
# passed KIND FILE -> 0 if `test` passed for FILE's current contents
passed() { typeset t; t=$(cat "$STATE/tested.$1" 2>/dev/null); [ -n "$t" ] && [ "$t" = "$(fsum "$2")" ]; }

# ------------------------------------------------------------------ discovery
lan_if() {
	[ -n "$LAN_IF" ] && { echo "$LAN_IF"; return; }
	ifconfig | awk -v mac="$LAN_MAC" '
		/^[a-z]/ { ifn=$1; sub(/:$/, "", ifn) }
		$1 == "lladdr" && tolower($2) == tolower(mac) { print ifn; exit }'
}

nat_if() {
	[ -n "$NAT_IF" ] && { echo "$NAT_IF"; return; }
	typeset i
	i=$(ifconfig | awk '/^[a-z]/ { ifn=$1; sub(/:$/, "", ifn) }
		$1 == "inet" && $2 ~ /^10\.0\.2\./ { print ifn; exit }')
	[ -z "$i" ] && [ -s "$STATE/nat_if" ] && i=$(cat "$STATE/nat_if")
	echo "$i"
}

# VirtualBox NAT gateway (10.0.2.2), remembered so boot-time routing can use it.
nat_gw() {
	typeset g
	# 0/1 + 128/1 via wg0 never replace "default", so this stays the NAT gateway.
	g=$(route -n get -inet default 2>/dev/null | awk '/gateway:/ { print $2; exit }')
	[ -z "$g" ] && g=$(cat "$STATE/nat_gw" 2>/dev/null)
	echo "${g:-10.0.2.2}"
}

is_ipv4() { echo "$1" | grep -Eq '^([0-9]{1,3}\.){3}[0-9]{1,3}$'; }
is_ipv6() { echo "$1" | grep -Eq '^[0-9A-Fa-f:.]*:[0-9A-Fa-f:.]*$'; }

# ------------------------------------------------------------------ Mullvad config parsing
# mv_field KEY FILE -> value of "KEY = value" (first match)
mv_field() { awk -v k="$1" '{ line=$0; sub(/[ \t]*=.*/, "", line) } line == k { sub(/^[^=]*=[ \t]*/, ""); sub(/[ \t\r]+$/, ""); print; exit }' "$2"; }
mv_current() { cat "$MV_DIR/current" 2>/dev/null; }
mv_file() { echo "$MV_CONFS/$(mv_current).conf"; }
mv_active() { grep -q "$MARK" "$WG_FILE" 2>/dev/null && ifconfig "$WG_IF" >/dev/null 2>&1; }
mv_addr4() { mv_field Address "$1" | tr ',' '\n' | grep -v ':' | head -n 1 | sed 's|/.*||'; }
mv_dns4() { mv_field DNS "$1" | tr ',' '\n' | tr -d ' ' | grep -v ':' | head -n 1; }
mv_ep_host() { typeset e; e=$(mv_field Endpoint "$1"); echo "${e%:*}" | tr -d '[]'; }
mv_ep_port() { typeset e; e=$(mv_field Endpoint "$1"); echo "${e##*:}"; }

mv_validate() {  # mv_validate FILE -> 0 if usable
	typeset f=$1
	[ -n "$(mv_field PrivateKey "$f")" ] && [ -n "$(mv_field PublicKey "$f")" ] &&
	[ -n "$(mv_addr4 "$f")" ] && is_ipv4 "$(mv_ep_host "$f")" && [ -n "$(mv_ep_port "$f")" ]
}

# ------------------------------------------------------------------ DNS helpers
backup_open_state() {
	[ -f "$STATE/dns_managed" ] && return 0
	mkdir -p "$STATE"
	cp -p /etc/resolv.conf "$STATE/resolv.conf.open" 2>/dev/null || : >"$STATE/resolv.conf.open"
	if [ -f /etc/dhcpleased.conf ]; then cp -p /etc/dhcpleased.conf "$STATE/dhcpleased.conf.open"
	else rm -f "$STATE/dhcpleased.conf.open"; fi
	nat_if >"$STATE/nat_if"
	: >"$STATE/dns_managed"
}

set_dns() {  # set_dns IP -- resolver = IP; DNS offered by the NAT's DHCP is ignored
	typeset ip=$1 nat
	nat=$(nat_if)
	backup_open_state
	printf '# %s (%s)\nnameserver %s\nlookup file bind\n' "$MARK" "$(mode)" "$ip" >/etc/resolv.conf
	chmod 644 /etc/resolv.conf
	if [ -n "$nat" ] && ! grep -q "$MARK" /etc/dhcpleased.conf 2>/dev/null; then
		{ cat /etc/dhcpleased.conf 2>/dev/null
		  echo "interface $nat { ignore dns }	# $MARK"; } >/etc/dhcpleased.conf.new
		chmod 644 /etc/dhcpleased.conf.new; mv /etc/dhcpleased.conf.new /etc/dhcpleased.conf
		rcctl restart dhcpleased >/dev/null 2>&1 || true
	fi
}

restore_dns() {
	[ -f "$STATE/dns_managed" ] || return 0
	if [ -s "$STATE/resolv.conf.open" ]; then cp -p "$STATE/resolv.conf.open" /etc/resolv.conf
	else : >/etc/resolv.conf; fi
	if [ -f "$STATE/dhcpleased.conf.open" ]; then cp -p "$STATE/dhcpleased.conf.open" /etc/dhcpleased.conf
	else rm -f /etc/dhcpleased.conf; fi
	rcctl restart dhcpleased >/dev/null 2>&1 || true
	rm -f "$STATE/dns_managed"
}

dns_answers() { dig @"$1" +time=2 +tries=1 +short "$TEST_DNS_NAME" A 2>/dev/null | grep -q .; }

# ------------------------------------------------------------------ mullvad
cmd_mv_import() {
	need_root
	typeset src=${1:-} tmp n=0 f
	[ -n "$src" ] || die "usage: privctl mullvad import FILE.conf|DIR|FILE.tgz|FILE.zip"
	[ -e "$src" ] || die "$src not found"
	install -d -o root -g wheel -m 0700 "$MV_DIR" "$MV_CONFS"
	tmp=$(mktemp -d) || die "mktemp failed"
	case $src in
	*.conf) cp "$src" "$tmp/" ;;
	*.tgz|*.tar.gz|*.tar) tar -xzf "$src" -C "$tmp" 2>/dev/null || tar -xf "$src" -C "$tmp" ;;
	*.zip) command -v unzip >/dev/null 2>&1 || { rm -rf "$tmp"; die "no unzip in base: repack on the host as .tgz (see README) or copy the .conf files"; }
	       unzip -q "$src" -d "$tmp" ;;
	*) [ -d "$src" ] || { rm -rf "$tmp"; die "unsupported: $src"; }; cp "$src"/*.conf "$tmp/" ;;
	esac
	find "$tmp" -type f -name '*.conf' >"$tmp.list"
	while IFS= read -r f; do
		if mv_validate "$f"; then install -o root -g wheel -m 0600 "$f" "$MV_CONFS/$(basename "$f")"; n=$((n + 1))
		else warn "skipped (not a usable WireGuard config): $(basename "$f")"; fi
	done <"$tmp.list"
	rm -f "$tmp.list"
	rm -rf "$tmp"
	[ $n -gt 0 ] || die "no usable Mullvad configs found in $src"
	ok "imported $n configs into $MV_CONFS (root-only, mode 0600)"
	say "   next: privctl mullvad list   then   privctl mullvad use <name or country prefix>"
}

cmd_mv_list() {
	typeset p=${1:-} f n
	[ -d "$MV_CONFS" ] || die "no configs imported yet (privctl mullvad import ...)"
	for f in "$MV_CONFS"/"$p"*.conf; do
		[ -f "$f" ] || continue
		n=$(basename "$f" .conf)
		printf '%-22s %s:%s%s\n' "$n" "$(mv_ep_host "$f")" "$(mv_ep_port "$f")" "$([ "$n" = "$(mv_current)" ] && echo '   <- in use')"
	done
}

cmd_mv_use() {
	need_root
	typeset want=${1:-} f cand name pk pub ep port a4 gw
	# NAME = exact server; PREFIX (se, se-sto, us-nyc) or nothing = random match.
	[ "$(mode)" = open ] || die "unlock first (privctl unlock), switch server, test, then lock again"
	if [ -f "$MV_CONFS/$want.conf" ]; then f="$MV_CONFS/$want.conf"
	else
		set -A cand -- "$MV_CONFS"/"$want"*.conf
		[ -f "${cand[0]}" ] || die "no config matches '$want' (privctl mullvad list)"
		f=${cand[$((RANDOM % ${#cand[@]}))]}
	fi
	mv_validate "$f" || die "$f is not a usable WireGuard config"
	name=$(basename "$f" .conf)
	pk=$(mv_field PrivateKey "$f"); pub=$(mv_field PublicKey "$f")
	ep=$(mv_ep_host "$f"); port=$(mv_ep_port "$f"); a4=$(mv_addr4 "$f")
	gw=$(nat_gw)
	mkdir -p "$STATE"; echo "$gw" >"$STATE/nat_gw"; nat_if >"$STATE/nat_if"

	[ -f "$WG_FILE" ] && ! grep -q "$MARK" "$WG_FILE" && die "$WG_FILE exists and was not written by privctl -- move it away first"
	cmd_mv_teardown quiet
	{
		echo "# $MARK mullvad use $name -- Mullvad WireGuard (IPv4 only: your configs carry no IPv6)"
		echo "wgkey $pk"
		echo "wgpeer $pub wgendpoint $ep $port wgaip 0.0.0.0/0"
		echo "inet $a4 255.255.255.255"
		echo "up"
		echo "!$SELF mullvad routes"
	} >"$WG_FILE.new"
	chmod 600 "$WG_FILE.new"; mv "$WG_FILE.new" "$WG_FILE"
	echo "$name" >"$MV_DIR/current"
	sh /etc/netstart "$WG_IF" || die "netstart $WG_IF failed"
	set_dns "$(mv_dns4 "$f")"
	ok "$WG_IF up via $name ($ep:$port); all IPv4 traffic now routes through Mullvad"
	ok "resolver: $(mv_dns4 "$f") (Mullvad DNS from your config, reached through the tunnel)"
	say "   /etc/hostname.$WG_IF makes this persistent across reboots. Next: privctl mullvad test"
}

# Routing for wg0: endpoint via the NAT gateway, everything else via wg0.
# Called from /etc/hostname.wg0 at boot (waits for the NAT DHCP lease) and by `use`.
cmd_mv_routes() {
	typeset f gw ep a4 i=0
	f=$(mv_file); [ -f "$f" ] || die "no Mullvad server selected"
	gw=$(cat "$STATE/nat_gw" 2>/dev/null); gw=${gw:-10.0.2.2}
	ep=$(mv_ep_host "$f"); a4=$(mv_addr4 "$f")
	while ! route -n get -inet "$gw" 2>/dev/null | grep -q 'interface:' && [ $i -lt 30 ]; do sleep 1; i=$((i + 1)); done
	route -qn delete -host "$ep" >/dev/null 2>&1
	route -qn add -host "$ep" "$gw" >/dev/null || warn "could not add endpoint route $ep via $gw"
	for net in 0.0.0.0/1 128.0.0.0/1; do
		route -qn delete -inet "$net" >/dev/null 2>&1
		route -qn add -inet "$net" "$a4" >/dev/null 2>&1 || route -qn add -inet "$net" -iface "$a4" >/dev/null 2>&1
	done
	if route -n get -inet 1.1.1.1 2>/dev/null | grep -q "interface: $WG_IF"; then logmsg "routes via $WG_IF set"
	else warn "Internet routes do not point at $WG_IF -- traffic will not flow (check: route -n show -inet)"; fi
}

cmd_mv_teardown() {
	typeset f
	if ifconfig "$WG_IF" >/dev/null 2>&1; then ifconfig "$WG_IF" destroy; fi
	f=$(mv_file)
	[ -f "$f" ] && route -qn delete -host "$(mv_ep_host "$f")" >/dev/null 2>&1
	[ "${1:-}" = quiet ] || ok "$WG_IF removed"
	return 0
}

cmd_mv_down() {
	need_root
	[ "$(mode)" = open ] || die "a lock is on -- without wg0 nothing could leave. Run privctl unlock first."
	cmd_mv_teardown
	if grep -q "$MARK" "$WG_FILE" 2>/dev/null; then mv "$WG_FILE" "$MV_DIR/hostname.$WG_IF.disabled"; fi
	restore_dns
	rm -f "$STATE/tested.mullvad"
	ok "Mullvad disabled (also at boot); normal NAT routing and DNS restored"
}

cmd_mv_test() {
	typeset out hs
	mv_active || die "Mullvad is not up (privctl mullvad use ...)"
	if route -n get -inet 1.1.1.1 2>/dev/null | grep -q "interface: $WG_IF"; then ok "Internet routes point at $WG_IF"
	else bad "routes do not use $WG_IF"; return 1; fi
	hs=$(ifconfig "$WG_IF" | awk '/last handshake/ { print; exit }')
	if [ -n "$hs" ]; then ok "WireGuard last${hs#*last}"; else warn "no handshake reported yet"; fi
	out=$(ftp -V -w 20 -o - "$MULLVAD_CHECK_URL" 2>/dev/null)
	case $out in
	*"You are connected to Mullvad"*) ok "$out" ;;
	*) bad "Mullvad check failed: ${out:-no answer from $MULLVAD_CHECK_URL}"; return 1 ;;
	esac
	if dns_answers "$(mv_dns4 "$(mv_file)")"; then ok "Mullvad DNS $(mv_dns4 "$(mv_file)") answers"
	else bad "Mullvad DNS does not answer"; return 1; fi
	mkdir -p "$STATE"; fsum "$WG_FILE" >"$STATE/tested.mullvad"
	ok "Mullvad works -- 'privctl lock mullvad' is now allowed"
}

# ------------------------------------------------------------------ hysteria
server_value() {
	awk '/^server:/ { sub(/^server:[ \t]*/, ""); sub(/[ \t]+#.*$/, ""); gsub(/["'\'']/, ""); print; exit }' "$HY_CONFIG"
}
server_host() {
	typeset v=$1
	case $v in
	\[*\]*) v=${v#\[}; echo "${v%%\]*}" ;;
	*:*:*) echo "$v" ;;
	*:*) echo "${v%%:*}" ;;
	*) echo "$v" ;;
	esac
}
server_port() {
	typeset v=$1
	case $v in
	\[*\]:*) echo "${v##*\]:}" ;;
	\[*\]|*:*:*) echo 443 ;;
	*:*) echo "${v#*:}" ;;
	*) echo 443 ;;
	esac
}
pf_ports() {
	[ -n "$SERVER_PF_PORTS" ] && { echo "$SERVER_PF_PORTS"; return; }
	case $1 in
	*,*) echo "{ $(echo "$1" | tr ',' ' ' | tr '-' ':') }" ;;
	*) echo "$1" | tr '-' ':' ;;
	esac
}
server_ips() {
	typeset h=$1 ips
	if is_ipv4 "$h" || is_ipv6 "$h"; then echo "$h"; return; fi
	ips=$(awk -v h="$h" -v b="$HOSTS_BEGIN" -v e="$HOSTS_END" '
		$0 == b { inb=1; next } $0 == e { inb=0 } inb && $2 == h { print $1 }' /etc/hosts)
	[ -z "$ips" ] && ips=$(host -W 5 "$h" 2>/dev/null | awk '/has address/ { print $NF } /has IPv6 address/ { print $NF }')
	echo "$ips" | tr '\n' ' ' | sed 's/ *$//'
}
pin_server() {  # pin_server HOST "IP IP..."
	typeset h=$1 ip tmp
	tmp=$(mktemp /etc/hosts.XXXXXX) || die "mktemp failed"
	awk -v b="$HOSTS_BEGIN" -v e="$HOSTS_END" '$0==b{skip=1;next} $0==e{skip=0;next} !skip' /etc/hosts >"$tmp"
	{ echo "$HOSTS_BEGIN"; for ip in $2; do echo "$ip	$h"; done; echo "$HOSTS_END"; } >>"$tmp"
	chmod 644 "$tmp" && mv "$tmp" /etc/hosts
	ok "pinned $h -> $2 in /etc/hosts (a lock blocks DNS until the tunnel is up)"
}
hy_running() { rcctl check hysteria >/dev/null 2>&1; }
hy_enabled() { rcctl ls on 2>/dev/null | grep -qx hysteria; }

cmd_hy_check() {
	typeset rc=0 left
	[ -f "$HY_CONFIG" ] || { bad "$HY_CONFIG missing (run install.sh)"; return 1; }
	left=$(grep -v '^[[:space:]]*#' "$HY_CONFIG" | grep -o '__[A-Z0-9_]*__' | sort -u | tr '\n' ' ')
	[ -n "$left" ] && { bad "unfilled placeholders in $HY_CONFIG: $left"; rc=1; }
	[ -n "$(server_value)" ] || { bad "no server: line in $HY_CONFIG"; rc=1; }
	[ -x /usr/local/bin/hysteria ] || { bad "/usr/local/bin/hysteria missing (run install.sh)"; rc=1; }
	[ -z "$(lan_if)" ] && { bad "no NIC with MAC $LAN_MAC (internal LAN)"; rc=1; }
	[ $rc -eq 0 ] && ok "Hysteria config complete (server: $(server_value))"
	return $rc
}

cmd_hy() {
	typeset sub=${1:-}
	case $sub in
	check-config) cmd_hy_check ;;
	start) need_root; cmd_hy_check >/dev/null || { cmd_hy_check; exit 1; }; rcctl -f start hysteria ;;
	stop) need_root; rcctl stop hysteria
	      [ "$(mode)" = tunnel ] && say "note: lock tunnel is on -- nothing reaches the Internet until you start it again or unlock"
	      return 0 ;;
	restart) need_root; rcctl -f restart hysteria ;;
	enable) need_root; rcctl enable hysteria; watchdog_cron add; ok "hysteria starts at boot; watchdog restarts it within 2 min if it dies" ;;
	disable) need_root; rcctl disable hysteria; watchdog_cron del; ok "hysteria no longer starts at boot" ;;
	test) cmd_hy_test ;;
	*) die "usage: privctl hy2 check-config|start|stop|restart|enable|disable|test" ;;
	esac
}

watchdog_cron() {
	typeset tmp; tmp=$(mktemp) || die "mktemp failed"
	crontab -l -u root 2>/dev/null | grep -v 'privctl watchdog' >"$tmp"
	[ "$1" = add ] && echo "*/2	*	*	*	*	$SELF watchdog >/dev/null 2>&1" >>"$tmp"
	crontab -u root "$tmp"; rm -f "$tmp"
}

cmd_watchdog() {
	if hy_enabled && ! hy_running; then
		logmsg "hysteria not running -- restarting (mode $(mode))"
		rcctl start hysteria >/dev/null 2>&1
	fi
	return 0
}

cmd_hy_test() {
	typeset rc=0 ans
	hy_running || die "Hysteria is not running (privctl hy2 start)"
	cmd_hy_check >/dev/null || { cmd_hy_check; exit 1; }
	mv_active && say "(Mullvad is up: Hysteria's QUIC goes through $WG_IF)"
	if http_proxy="http://$LAN_ADDR:8080" ftp -V -w 20 -o /dev/null "$HY2_TEST_URL" 2>/dev/null; then
		ok "HTTPS via Hysteria HTTP proxy $LAN_ADDR:8080"
	else bad "HTTPS via Hysteria HTTP proxy failed (server/auth/sni? grep hysteria /var/log/daemon)"; rc=1; fi
	ans=$(dig @"$LAN_ADDR" -p 5353 +time=5 +tries=1 +short "$TEST_DNS_NAME" A 2>/dev/null | head -n 1)
	if [ -n "$ans" ]; then ok "DNS via Hysteria UDP forwarder $LAN_ADDR:5353 ($ans)"
	else bad "DNS via UDP forwarder $LAN_ADDR:5353 failed (REMOTE_DNS_RESOLVER?)"; rc=1; fi
	ans=$(dig @"$LAN_ADDR" -p 5353 +tcp +time=5 +tries=1 +short "$TEST_DNS_NAME" A 2>/dev/null | head -n 1)
	if [ -n "$ans" ]; then ok "DNS via Hysteria TCP forwarder $LAN_ADDR:5353"
	else bad "DNS via TCP forwarder $LAN_ADDR:5353 failed"; rc=1; fi
	if [ $rc -eq 0 ]; then
		mkdir -p "$STATE"; fsum "$HY_CONFIG" >"$STATE/tested.hy2"
		ok "Hysteria works -- 'privctl lock tunnel' is now allowed"
	fi
	return $rc
}

# ------------------------------------------------------------------ pf generation
gen_pf() {  # gen_pf mullvad|tunnel -> $PF_OUT (validated)
	typeset m=$1 nat lan f ep port hyips="" hyports="" egress v6=0 ip
	nat=$(nat_if); lan=$(lan_if)
	[ -n "$nat" ] || die "cannot determine the NAT interface; set NAT_IF in $SETTINGS"
	[ -n "$lan" ] || die "cannot find the LAN interface (MAC $LAN_MAC); set LAN_IF in $SETTINGS"
	if mv_active; then f=$(mv_file); ep=$(mv_ep_host "$f"); port=$(mv_ep_port "$f"); egress=$WG_IF
	else egress=$nat; fi
	if [ "$m" = tunnel ]; then
		typeset v h
		v=$(server_value); h=$(server_host "$v")
		hyips=$(server_ips "$h"); hyports=$(pf_ports "$(server_port "$v")")
		[ -n "$hyips" ] || die "cannot resolve Hysteria server '$h' -- use an IP literal in $HY_CONFIG"
		if ! is_ipv4 "$h" && ! is_ipv6 "$h"; then pin_server "$h" "$hyips"; fi
		for ip in $hyips; do is_ipv6 "$ip" && v6=1; done
		[ $v6 -eq 1 ] && mv_active && die "IPv6 Hysteria server, but your Mullvad configs are IPv4-only -- use the server's IPv4 address"
	fi
	{
	echo "# $MARK lock $m on $(date)"
	echo "# Fail closed: anything not explicitly passed below is blocked (IPv4 and IPv6)."
	echo "nat_if = \"$nat\""
	echo "lan_if = \"$lan\""
	echo "lan_addr = \"$LAN_ADDR\""
	echo "services = \"$SERVICES_IP\""
	[ -n "$hyips" ] && echo "table <hy2_server> const { $(echo "$hyips" | tr ' ' ',') }"
	echo "set block-policy return"
	echo "set skip on lo0"
	echo "block log all"
	[ $v6 -eq 1 ] || echo "block return quick inet6 all"
	echo "# DHCP keeps the NAT lease alive; its DNS is ignored (dhcpleased.conf)"
	echo "pass out quick on \$nat_if inet proto udp from any port 68 to any port 67"
	echo "pass in  quick on \$nat_if inet proto udp from any port 67 to any port 68"
	echo "# Administration: SSH via the VirtualBox NAT port-forward"
	echo "pass in quick on \$nat_if inet proto tcp from $ADMIN_SSH_FROM to (\$nat_if) port $ADMIN_SSH_PORT"
	if [ -n "${ep:-}" ]; then
		echo "# Mullvad: the only packets allowed out of the NAT NIC are WireGuard to your endpoint"
		echo "pass out quick on \$nat_if inet proto udp to $ep port $port"
	fi
	if [ "$m" = mullvad ]; then
		echo "# Everything from this VM, and from the services VM (NATed), leaves through Mullvad"
		echo "match out on $WG_IF inet from \$services nat-to ($WG_IF)"
		echo "pass out quick on $WG_IF inet"
		echo "pass in quick on \$lan_if inet from \$services to ! $LAN_NET"
	else
		echo "# Only Hysteria's QUIC (user _hysteria) to the pinned server may leave$( [ -n "${ep:-}" ] && echo ' -- inside Mullvad')"
		echo "pass out quick on $egress proto udp to <hy2_server> port $hyports user _hysteria"
	fi
	echo "# Internal LAN <-> services VM (Pi-hole, SearXNG, SSH jump) and the Hysteria listeners"
	echo "pass out quick on \$lan_if inet from \$lan_addr to \$services"
	echo "pass in  quick on \$lan_if inet proto { tcp udp } from \$services to \$lan_addr port { $LAN_PROXY_PORTS }"
	echo "pass in  quick on \$lan_if inet proto icmp from \$services to \$lan_addr icmp-type echoreq"
	} >"$PF_OUT.new"
	pfctl -nf "$PF_OUT.new" || { rm -f "$PF_OUT.new"; die "generated pf rules do not parse -- nothing changed"; }
	chmod 600 "$PF_OUT.new"; mv "$PF_OUT.new" "$PF_OUT"
}

# ------------------------------------------------------------------ locks
cmd_lock() {
	need_root
	typeset m=${1:-} force=${2:-} dns nat natip token
	case $m in mullvad|tunnel) ;; *) die "usage: privctl lock mullvad|tunnel [--force]" ;; esac
	if [ "$m" = mullvad ]; then
		mv_active || die "Mullvad is not up (privctl mullvad use ...)"
		[ "$force" = --force ] || passed mullvad "$WG_FILE" \
			|| die "run 'privctl mullvad test' successfully first (or --force)"
	else
		cmd_hy_check || exit 1
		hy_running || die "start Hysteria first (privctl hy2 start), then privctl hy2 test"
		[ "$force" = --force ] || passed hy2 "$HY_CONFIG" \
			|| die "run 'privctl hy2 test' successfully first (or --force)"
	fi
	gen_pf "$m"
	ok "pf ruleset generated and validated: $PF_OUT"

	# Resolver: Pi-hole if it answers; otherwise Mullvad DNS (lock mullvad). Never the NAT resolver.
	if dns_answers "$PIHOLE_DNS"; then dns=$PIHOLE_DNS
	elif [ "$m" = mullvad ]; then dns=$(mv_dns4 "$(mv_file)")
	else dns=$PIHOLE_DNS; warn "Pi-hole $PIHOLE_DNS does not answer yet; DNS fails until it does (fail closed)"; fi

	if [ "$m" = mullvad ]; then
		[ "$(sysctl -n net.inet.ip.forwarding)" = 1 ] || { sysctl -q net.inet.ip.forwarding=1; : >"$STATE/fwd_set"; }
	else
		[ -f "$STATE/fwd_set" ] && { sysctl -q net.inet.ip.forwarding=0; rm -f "$STATE/fwd_set"; }
	fi
	pfctl -e >/dev/null 2>&1 || true
	pfctl -f "$PF_OUT" || { cmd_unlock; die "pf refused the ruleset -- reverted"; }
	set_mode "$m"
	set_dns "$dns"
	# Drop direct flows this VM started before the lock (the inbound SSH admin state survives).
	nat=$(nat_if); natip=$(ifconfig "$nat" | awk '$1 == "inet" { print $2; exit }')
	[ -n "$natip" ] && pfctl -k "$natip" >/dev/null 2>&1
	pfctl -k ::/0 >/dev/null 2>&1
	logmsg "lock $m on (dns $dns)"

	token=$(date +%s)$$
	echo "$token" >"$STATE/pending"
	nohup "$SELF" _auto-revert "$token" >/dev/null 2>&1 &
	say ""
	say "LOCK '$m' ON. Resolver: $dns. Open a NEW ssh session to prove you still get in,"
	say "then within ${CONFIRM_TIMEOUT}s run:   doas privctl confirm"
	say "Otherwise the normal ruleset comes back automatically."
}

cmd_auto_revert() {
	sleep "$CONFIRM_TIMEOUT"
	[ "$(cat "$STATE/pending" 2>/dev/null)" = "${1:-x}" ] || exit 0
	logmsg "lock not confirmed within ${CONFIRM_TIMEOUT}s -- unlocking"
	cmd_unlock
}

cmd_confirm() {
	need_root
	[ -s "$STATE/pending" ] || { say "nothing pending"; return 0; }
	rm -f "$STATE/pending"
	ok "lock '$(mode)' confirmed (runtime; 'privctl persist' keeps it across reboots)"
}

cmd_persist() {
	need_root
	typeset m; m=$(mode)
	[ "$m" != open ] || die "no lock is on"
	[ -s "$STATE/pending" ] && die "confirm the lock first (privctl confirm)"
	grep -q "$MARK" /etc/pf.conf 2>/dev/null || cp -p /etc/pf.conf "$STATE/pf.conf.orig"
	cp "$PF_OUT" /etc/pf.conf
	if [ "$m" = mullvad ]; then
		grep -q '^net.inet.ip.forwarding=1' /etc/sysctl.conf 2>/dev/null || echo "net.inet.ip.forwarding=1	# $MARK" >>/etc/sysctl.conf
	fi
	if [ "$m" = tunnel ]; then rcctl enable hysteria; watchdog_cron add; fi
	ok "lock '$m' persists across reboots (/etc/pf.conf$( [ "$m" = mullvad ] && echo ', ip forwarding')$( [ "$m" = tunnel ] && echo ', hysteria at boot'))"
	say "   Undo: privctl unlock"
}

cmd_unlock() {
	[ "$(id -u)" -eq 0 ] || die "run as root: doas privctl unlock  (the VirtualBox console always works)"
	rm -f "$STATE/pending"
	if grep -q "$MARK" /etc/pf.conf 2>/dev/null; then
		if [ -s "$STATE/pf.conf.orig" ]; then cp -p "$STATE/pf.conf.orig" /etc/pf.conf
		else cp /etc/examples/pf.conf /etc/pf.conf; fi
		say " restored /etc/pf.conf (lock no longer persistent)"
	fi
	if grep -q "$MARK" /etc/sysctl.conf 2>/dev/null; then
		grep -v "$MARK" /etc/sysctl.conf >/etc/sysctl.conf.new; chmod 644 /etc/sysctl.conf.new; mv /etc/sysctl.conf.new /etc/sysctl.conf
	fi
	[ -f "$STATE/fwd_set" ] && { sysctl -q net.inet.ip.forwarding=0; rm -f "$STATE/fwd_set"; }
	pfctl -f /etc/pf.conf && say " loaded /etc/pf.conf (normal ruleset)"
	set_mode open
	if mv_active; then set_dns "$(mv_dns4 "$(mv_file)")"; say " Mullvad stays up (routing), resolver: Mullvad DNS"
	else restore_dns; fi
	logmsg "unlocked"
	ok "UNLOCKED: normal pf ruleset. $(mv_active && echo 'Traffic still routes via Mullvad (privctl mullvad down to stop).')"
}

# ------------------------------------------------------------------ status / misc
cmd_status() {
	typeset m; m=$(mode)
	say "lock            : $m$( [ -s "$STATE/pending" ] && echo '  (UNCONFIRMED: privctl confirm, or it auto-reverts)')$(grep -q "$MARK" /etc/pf.conf 2>/dev/null && echo '  (persistent)')"
	say "pf              : $(pfctl -s info 2>/dev/null | awk '/^Status:/ { print $2 }')"
	if mv_active; then
		say "mullvad         : UP via $(mv_current) -> $(mv_ep_host "$(mv_file)"); $(ifconfig "$WG_IF" | awk '/last handshake/ { sub(/^[ \t]*/, ""); print; exit }')"
	else say "mullvad         : down$( [ -d "$MV_CONFS" ] && echo " ($(find "$MV_CONFS" -name '*.conf' | wc -l | tr -d ' ') configs imported)")"; fi
	say "internet route  : $(route -n get -inet 1.1.1.1 2>/dev/null | awk '/interface:/ { print $2 }')"
	say "hysteria        : $(hy_running && echo running || echo stopped) (boot: $(hy_enabled && echo on || echo off))"
	say "interfaces      : NAT=$(nat_if)  LAN=$(lan_if) ($LAN_ADDR)"
	say "resolv.conf     : $(awk '/^nameserver/ { printf "%s ", $2 }' /etc/resolv.conf)"
	say "tests passed    : mullvad=$(passed mullvad "$WG_FILE" && echo yes || echo no)  hy2=$(passed hy2 "$HY_CONFIG" && echo yes || echo no)"
}

cmd_proxy_env() {
	cat <<EOF
# Only needed for lock tunnel (Hysteria). With Mullvad alone, no proxy is needed.
export http_proxy=http://$LAN_ADDR:8080
export https_proxy=http://$LAN_ADDR:8080
export ALL_PROXY=socks5h://$LAN_ADDR:1080
export no_proxy=localhost,127.0.0.1,$SERVICES_IP
# Firefox: Settings > Network > Manual proxy: SOCKS host $LAN_ADDR port 1080,
# SOCKS v5, and enable "Proxy DNS when using SOCKS v5".
EOF
}

usage() { sed -n '3,30p' "$0" | sed 's/^# \{0,1\}//'; exit 2; }

case ${1:-} in
status) cmd_status ;;
mullvad)
	case ${2:-} in
	import) cmd_mv_import "${3:-}" ;;
	list) cmd_mv_list "${3:-}" ;;
	use) cmd_mv_use "${3:-}" ;;
	routes) cmd_mv_routes ;;
	test) cmd_mv_test ;;
	down) cmd_mv_down ;;
	*) usage ;;
	esac ;;
hy2) cmd_hy "${2:-}" ;;
lock) cmd_lock "${2:-}" "${3:-}" ;;
confirm) cmd_confirm ;;
persist) cmd_persist ;;
unlock|recover) cmd_unlock ;;
proxy-env) cmd_proxy_env ;;
watchdog) cmd_watchdog ;;
_auto-revert) cmd_auto_revert "${2:-}" ;;
*) usage ;;
esac
